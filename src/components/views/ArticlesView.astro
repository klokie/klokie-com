---
import { getCollection } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { localizedEntries, localizeUrl, dateLocale, type Locale } from "@/i18n";
import { t } from "@/i18n/ui";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);

const all = await getCollection("articles", ({ data }) => !data.draft);
const articles = localizedEntries(all, lang).sort(
  (a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat(dateLocale[lang], {
  year: "numeric",
  month: "short",
});
const tagFor = (topic?: string) => topic?.toLowerCase();
---

<SiteLayout lang={lang} title={tr("articles.title")} description={tr("articles.metaDesc")}>
  <section class="hero container">
    <h1>{tr("articles.title")}<em>.</em></h1>
    <p class="lede">{tr("articles.metaDesc")}</p>
  </section>

  <div id="filterbar" class="container mono idle">
    <span class="active-tag"></span><span id="count"></span>
    <button id="clear">{tr("work.clear")}</button>
  </div>

  <div
    class="list container"
    data-word-one={tr("articles.article")}
    data-word-many={tr("articles.articles.short")}
  >
    {articles.length === 0 && <p class="muted">{tr("articles.empty")}</p>}
    <ul>
      {
        articles.map(({ slug, entry: { data } }) => (
          <li class="row" data-entry data-tags={tagFor(data.topics[0]) ?? ""}>
            <a class="row-link" href={localizeUrl(`/articles/${slug}/`, lang)}>
              <span class="name">{data.title}</span>
            </a>
            <span class="meta mono">
              {data.topics[0] && (
                <>
                  <button class="tag minitag" data-tag={tagFor(data.topics[0])}>
                    {data.topics[0]}
                  </button>
                  {" · "}
                </>
              )}
              {fmt.format(data.date)}
            </span>
          </li>
        ))
      }
    </ul>
    {articles.length > 0 && <p class="muted more">{tr("articles.empty")}</p>}
  </div>
</SiteLayout>

<style>
  .mono { font-family: var(--font-mono); }
  .hero { padding: 64px 24px 8px; }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.02;
    margin-bottom: 16px;
  }
  h1 em { font-style: normal; color: var(--primary); }
  .lede { color: var(--muted); max-width: 52ch; font-size: 1.1rem; }

  .tag {
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    border-bottom: 1px dotted transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .tag:not(:disabled):hover,
  .tag.on { color: var(--primary); border-bottom-color: var(--primary); }
  .tag:disabled { cursor: default; }

  #filterbar {
    padding-top: 8px;
    padding-bottom: 8px;
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    min-height: 28px;
    display: flex;
    gap: 16px;
    align-items: center;
  }
  #filterbar .active-tag {
    color: var(--bg);
    background: var(--primary);
    border-radius: 3px;
    padding: 2px 8px;
  }
  #filterbar #clear {
    cursor: pointer;
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 3px;
    font: inherit;
    padding: 2px 8px;
    letter-spacing: inherit;
    text-transform: inherit;
  }
  #filterbar #clear:hover { color: var(--primary); border-color: var(--primary); }
  #filterbar.idle .active-tag,
  #filterbar.idle #count,
  #filterbar.idle #clear { display: none; }

  .list { padding-bottom: 96px; }
  .list ul { list-style: none; margin: 0; padding: 0; }
  .list li.row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px dotted var(--border-soft);
  }
  .list li.row.hide { display: none; }
  .row-link { color: var(--text); }
  .row-link:hover { text-decoration: none; }
  .row-link:hover .name { color: var(--primary); }
  .name { font-size: 1.15rem; font-weight: 400; }
  .meta { font-size: 11px; color: var(--dim); letter-spacing: 0.08em; white-space: nowrap; }
  .minitag {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: none;
    color: var(--primary);
  }
  .more { margin-top: 24px; font-size: 0.9rem; }
</style>

<script>
  const bar = document.getElementById("filterbar")!;
  const activeEl = bar.querySelector(".active-tag")!;
  const countEl = document.getElementById("count")!;
  const list = document.querySelector<HTMLElement>(".list")!;
  let active: string | null = null;

  function applyFilter(tag: string | null) {
    active = tag;
    let shown = 0;
    document.querySelectorAll<HTMLElement>("[data-entry]").forEach((e) => {
      const hit = !tag || (e.dataset.tags ?? "").split(",").includes(tag);
      e.classList.toggle("hide", !hit);
      if (hit) shown++;
    });
    document
      .querySelectorAll<HTMLElement>(".tag")
      .forEach((t) => t.classList.toggle("on", !!tag && t.dataset.tag === tag));
    bar.classList.toggle("idle", !tag);
    if (tag) {
      activeEl.textContent = tag;
      countEl.textContent = `${shown} ${
        shown === 1 ? list.dataset.wordOne : list.dataset.wordMany
      }`;
      history.replaceState(null, "", "#" + encodeURIComponent(tag));
    } else {
      history.replaceState(null, "", location.pathname);
    }
  }

  document.addEventListener("click", (e) => {
    const el = e.target as HTMLElement;
    const t = el.closest<HTMLElement>(".tag");
    if (t && t.dataset.tag) {
      applyFilter(active === t.dataset.tag ? null : t.dataset.tag);
    }
  });
  document.getElementById("clear")!.addEventListener("click", () => applyFilter(null));
  if (location.hash) applyFilter(decodeURIComponent(location.hash.slice(1)));
</script>
