---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { splitId, localePaths, defaultLocale, type Locale } from "@/i18n";
import { personJsonLd, CV_DETAILS } from "@/site/person";

interface Props {
  lang: Locale;
  entry: CollectionEntry<"pages">;
}
const { lang, entry } = Astro.props;
const translated = splitId(entry.id).lang === lang;
const { Content } = await render(entry);

// Pages that are *about* Daniel carry Person schema; the CV adds the
// employment/education detail that only belongs on a CV.
const slug = entry.data.slug ?? splitId(entry.id).slug;
const isCv = slug === "cv";
// On an untranslated fallback the canonical points at the default-locale page,
// so the schema must describe that page too — not the URL we happen to be on.
const isFallback = lang !== defaultLocale && !translated;
const schemaPath = isFallback ? localePaths(Astro.url.pathname)[defaultLocale] : Astro.url.pathname;
const jsonLd =
  isCv || slug === "about"
    ? personJsonLd({
        mainEntityOfPage: new URL(schemaPath, Astro.site ?? Astro.url).href,
        inLanguage: isFallback ? defaultLocale : lang,
        ...(isCv ? CV_DETAILS : {}),
      })
    : undefined;
---

<SiteLayout
  lang={lang}
  translated={translated}
  title={entry.data.title}
  description={entry.data.description}
  ogType={isCv ? "profile" : "website"}
  jsonLd={jsonLd}
>
  <article class="container">
    <div class="prose">
      <Content />
    </div>
  </article>
</SiteLayout>

<style>
  .container { max-width: 680px; margin: 0 auto; padding: 48px 24px 96px; }
  .prose :global(h1) {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: 24px;
  }
  .prose :global(h2) { font-size: 1.5rem; font-weight: 400; margin: 1.5em 0 0.6em; }
  .prose :global(h3) { font-size: 1.2rem; font-weight: 400; margin: 1.5em 0 0.5em; }
  .prose :global(p) { font-size: 1.05rem; line-height: 1.65; margin-bottom: 1.2em; }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.4em; margin-bottom: 1.2em; line-height: 1.65; }
  .prose :global(hr) { border: 0; height: 1px; background: var(--border); margin: 32px 0; }
</style>
